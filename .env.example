# Copy to .env.local and adjust if your Postgres differs.
#
#   cp .env.example .env.local
#
# Any Postgres 14+ with the btree_gist extension available works. The booking
# guarantee is a GiST exclusion constraint, so btree_gist is not optional.
#
# In production this value lives in the host's environment settings and is
# never committed. See design/threat-model.md (T7).
DATABASE_URL=postgres://localhost:5432/parkmitra_dev
