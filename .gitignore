# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# secrets — never commit. DATABASE_URL lives in the host's settings.

# build / test output
coverage/
playwright-report/
test-results/

# os
.DS_Store

# niha local-only state (the tool writes its own .niha/.gitignore too)
.niha/ledger.jsonl
.niha/settings.local.json

# .github/ was ignored while the only thing in it was a workflow niha
# regenerated unrequested and which could not be pushed without the workflow
# OAuth scope. That had a cost: CI never ran on this repository at all, which
# is how the generated workflow's broken action ref went unnoticed until
# phase 9 (niha-and-co/ai-platform#1033). Both are now committed.
# The workflow exactly as generated is preserved at
# field/artifacts/niha-generated-workflow.yml.

# typescript incremental build cache. dist/ is not a build output of this
# project at all — Next.js builds to .next/ — but a stray dist/tsconfig.tsbuildinfo
# got committed early and was only noticed during the v1.0.0 fresh-clone check.
*.tsbuildinfo
dist/

# playwright
test-results/
playwright-report/
.vercel

# secrets — never committed. DATABASE_URL lives in the host's environment
# settings (design/threat-model.md T7).
#
# Order matters and bit us once: `vercel link` appended its own `.env*` BELOW an
# earlier `!.env.example` negation, which silently re-ignored the example file.
# A judge following the README then hit 'cp: .env.example: No such file'. Keep
# this as the single env block, with the negation last.
.env
.env.*
!.env.example
